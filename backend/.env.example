# SizzleBite Backend — Environment Variables
# Copy this file to .env and fill in your Neon PostgreSQL DATABASE_URL

# Get your connection string from: https://console.neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=DATABASE_URL=your_neon_connection_string_here

# Server port (optional, defaults to 3001)
PORT=3001

# Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5500
